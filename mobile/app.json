{
  "expo": {
    "name": "Fleet Console",
    "slug": "fleet-console",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fleetconsole",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07111F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fleetconsole.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Fleet Console uses your location during a shift to record attendance and show your field team where you are.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Fleet Console records your location during shifts, including when the app is in the background, so attendance and field positions stay accurate.",
        "NSMotionUsageDescription": "Motion data helps distinguish a moving shift from a stationary one and improves location accuracy.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fleetconsole.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fleet Console uses your location during a shift to record attendance and show field positions.",
          "locationAlwaysAndWhenInUsePermission": "Fleet Console records your location during shifts, including in the background, so attendance and field positions stay accurate.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B82F6",
          "defaultChannel": "default"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
