# Supabase project used by the Fleet Console backend.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the Next.js Fleet Console deployment.
EXPO_PUBLIC_API_URL=https://fleet-console.example.com

# Optional: EAS project id, required for Expo push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional MapLibre style. Defaults to OpenStreetMap raster tiles.
EXPO_PUBLIC_MAP_STYLE_URL=

# Optional privacy policy URL shown during consent.
EXPO_PUBLIC_PRIVACY_URL=
