NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key from Supabase Project Settings -> API -> service_role.
# Used by the "Add employee" admin flow. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used in sign-in invite links. Set this in production so the
# Supabase redirect lands on /welcome instead of the project's default Site URL.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: send invite emails automatically through Brevo's free HTTP API
# (300 messages/day, no card). Without these, the Add employee flow shows a
# copyable one-time invite link instead — it still works with no email setup.
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=Fleet Console <no-reply@your-domain.example>
